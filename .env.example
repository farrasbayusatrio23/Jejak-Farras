# Supabase (wajib). Isi di Vercel > Project Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Gunakan salah satu: penamaan baru (publishable/secret) atau legacy (anon/service role).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

SUPABASE_STORAGE_BUCKET=journal-media

# Harus sama dengan email user editor di Supabase Authentication.
EDITOR_EMAIL=you@example.com
